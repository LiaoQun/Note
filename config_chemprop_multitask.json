{
    "data": {
        "data_paths": [
            "examples/test_data.csv.gz"
        ],
        "test_size": 0.1,
        "val_size": 0.1,
        "sample_percentage": 1.0,
        "featurizer_type": "ChemPropFeaturizer",
        "target_columns": [
            "bde",
            "bdfe"
        ]
    },
    "model": {
        "atom_features": 128,
        "num_messages": 3,
        "num_tasks": 2
    },
    "train": {
        "device": "cpu",
        "epochs": 5,
        "lr": 0.001,
        "batch_size": 32,
        "model_save_path": "bde_model.pt",
        "output_dir": "training_runs"
    }
}